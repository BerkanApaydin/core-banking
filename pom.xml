<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath />
    </parent>

    <groupId>com.bank</groupId>
    <artifactId>clean-architecture-bank</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>clean-architecture-bank</name>
    <description>DDD modular monolith with hexagonal bounded contexts on Spring Boot</description>

    <modules>
        <!-- Schema ownership: resources-only module (classpath:db/migration) -->
        <module>migrations</module>
        <!-- Shared kernel: stable, low-level, no BC dependencies -->
        <module>common</module>
        <!-- Shared web rendering: depends only on common, used by BC web adapters
             and platform filters; keeps Spring out of the shared kernel. -->
        <module>web-support</module>
        <module>persistence</module>
        <module>account-api</module>
        <!-- Cross-cutting adapters: implement context-owned ports, so they
             compile against port-owning BC modules (account, user, audit) -->
        <module>infrastructure</module>
        <!-- Bounded contexts (modular monolith slices, each hexagonal inside) -->
        <module>account</module>
        <module>transfer</module>
        <module>user</module>
        <!-- Supporting subdomain -->
        <module>audit</module>
        <!-- Bootstrap / composition root -->
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- T-12: reproducible builds — fixes timestamps inside jars so the
             same sources always produce the same bytes. -->
        <project.build.outputTimestamp>2026-09-27T00:00:00Z</project.build.outputTimestamp>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mockito.version>5.12.0</mockito.version>
        <!-- F-09: mockito 5.12.0 is pinned (not Boot-managed) on purpose: it is the
             newest version vendored in the offline build cache and verified against
             the 1.812-test suite. Removing the pin floats to Boot's managed version
             on the next upgrade — re-verify IdempotencyAspectTest/Mockito strictness
             then. byte-buddy below MUST stay aligned with mockito's requirement. -->
        <!-- F-01: 1.17.5 -> 1.17.8 minimum. 1.17.8 fixes dynamic attach on
             Windows ("Fix dynamic attach on Windows when a service user is
             active"); on <=1.17.7 every surefire JVM falls back to the
             external attacher child-JVM, which flakes under commit pressure
             ("Could not self-attach to current VM using external process").
             Matches Spring Boot 3.5.16's managed byte-buddy (1.17.8). -->
        <byte-buddy.version>1.17.8</byte-buddy.version>
        <!-- Dependency-review gate (scripts/dependency_review.py, OSV):
             pinned above upstream to close HIGH/CRITICAL advisories. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <!-- OSV moderate advisories: override Boot 3.5.16's managed versions
             with the first fixed releases. Keep these until the next Boot
             upgrade manages them at or above these floors. -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <log4j2.version>2.25.5</log4j2.version>
        <opentelemetry.version>1.62.0</opentelemetry.version>
        <!-- 10.1.58 was withdrawn upstream; 10.1.59 is the first published fix. -->
        <tomcat.version>10.1.59</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>
        <netty.version>4.1.137.Final</netty.version>
        <!-- Upper-bound alignment with springdoc/swagger 2.2.27:
             jakarta.validation-api:3.1.0 is requested by swagger-core-jakarta
             and snakeyaml:2.5 by the managed jackson-dataformat-yaml:2.21.7.
             Keep the managed versions at those floors so RequireUpperBoundDeps
             stays clean (see the enforcer comment below). -->
        <snakeyaml.version>2.5</snakeyaml.version>
        <jakarta-validation.version>3.1.0</jakarta-validation.version>
        <!-- okhttp 5.3.2 (transitive of opentelemetry-exporter-otlp) is
             compiled against Kotlin 2.2.x; Boot 3.5.16 still manages 1.9.25,
             which trips RequireUpperBoundDeps below. No Kotlin sources are
             compiled here, so aligning the stdlib floor is safe. -->
        <kotlin.version>2.2.21</kotlin.version>
        <jacoco.line.coverage>0.90</jacoco.line.coverage>
        <jacoco.branch.coverage>0.80</jacoco.branch.coverage>
        <jacoco.version>0.8.15</jacoco.version>
        <postgresql.image.tag>15-alpine</postgresql.image.tag>
        <testcontainers.version>1.20.6</testcontainers.version>
        <!-- F-10: flyway.version is declared explicitly (not left to Boot's BOM) so
             the migration dialect is a deliberate, reviewable choice. Must match
             spring-boot-dependencies' managed Flyway for Boot 3.5.x (11.7.x);
             bump together with the Boot parent. -->
        <flyway.version>11.7.2</flyway.version>
        <pitest.version>1.19.1</pitest.version>
        <jacoco.skip>false</jacoco.skip>
        <jjwt.version>0.12.7</jjwt.version>
        <springdoc.version>2.8.3</springdoc.version>
        <logstash.logback.version>7.4</logstash.logback.version>
        <spring-boot.skip>true</spring-boot.skip>
        <archunit.version>1.3.0</archunit.version>
        <awaitility.version>4.2.2</awaitility.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <pitest-junit5-plugin.version>1.2.2</pitest-junit5-plugin.version>
        <!-- Audit #6: per-module PIT targetClasses live in module poms but resolve
             through THESE properties (single source of truth). The pitest-domain
             profile below redefines them to domain-only patterns, so the nightly
             85% domain gate no longer depends on a -DtargetClasses CLI flag
             (kept in mutation-nightly.yml as a harmless explicit override).
             Domain-free modules resolve to patterns that match nothing; the
             profile also sets failWhenNoMutations=false so they pass. -->
        <pitest.targetClasses.account>com.bank.app.account.*</pitest.targetClasses.account>
        <pitest.targetClasses.accountApi>com.bank.app.account.api.*</pitest.targetClasses.accountApi>
        <pitest.targetClasses.app>com.bank.app.*</pitest.targetClasses.app>
        <pitest.targetClasses.audit>com.bank.app.audit.*</pitest.targetClasses.audit>
        <pitest.targetClasses.common>com.bank.app.common.*</pitest.targetClasses.common>
        <pitest.targetClasses.infrastructure>com.bank.app.infrastructure.*</pitest.targetClasses.infrastructure>
        <pitest.targetClasses.persistence>com.bank.app.persistence.*</pitest.targetClasses.persistence>
        <pitest.targetClasses.transfer>com.bank.app.transfer.*</pitest.targetClasses.transfer>
        <pitest.targetClasses.user>com.bank.app.user.*</pitest.targetClasses.user>
        <pitest.targetClasses.webSupport>com.bank.app.websupport.*</pitest.targetClasses.webSupport>
        <jacoco.argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- OSV HIGH/CRITICAL (netty SNI bypass, bzip2 loop): 4.1.135 -> 4.1.137. -->
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash.logback.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <!-- D19: bounded async waits in tests instead of raw Thread.sleep. -->
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5-plugin.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Test dependencies inherited by all modules -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <parallel>classes</parallel>
                        <!-- Bounded (F-08): useUnlimitedThreads=true with ~278
                             test classes exhausted threads/memory and produced
                             hs_err JVM crashes. 4 threads share one forked JVM;
                             Testcontainers ITs run separately in failsafe. -->
                        <threadCount>4</threadCount>
                        <!-- V46 stores wall-clock columns as TIMESTAMPTZ: the
                             driver/JVM zone IS the stored clock. Production pins
                             UTC via Dockerfile TZ + -Duser.timezone=UTC; tests
                             must run in the same zone or business-time
                             comparisons (window cutoffs, cancellation window)
                             shift by the host offset (found: +03:00 host made
                             a 1h-old row look future-dated). -->
                        <argLine>@{jacoco.argLine} -Dfile.encoding=${project.build.sourceEncoding} -Duser.timezone=UTC</argLine>
                        <excludes>
                            <exclude>**/*IntegrationTest.java</exclude>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <argLine>@{jacoco.argLine} -Dfile.encoding=${project.build.sourceEncoding} -Duser.timezone=UTC</argLine>
                        <includes>
                            <include>**/*IntegrationTest.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
                        <skip>${spring-boot.skip}</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-java-and-maven</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireJavaVersion>
                                        <version>[21,)</version>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                    <!-- Single version per artifact across the reactor.
                                         dependency:analyze output is advisory (starter
                                         aggregation noise); convergence is enforced. -->
                                    <dependencyConvergence />
                                    <!-- Audit #5: fail the build when a transitive version
                                         outranks the managed one (silent downgrade risk) and
                                         ban legacy logging bridges that split the log
                                         pipeline (log4j-over-slf4j/slf4j-log4j12 style
                                         loops and commons-logging duplicates).
                                         The known springdoc/swagger drift is aligned in
                                         properties above (snakeyaml 2.5 and
                                         jakarta.validation-api 3.1.0, see F-10), so this
                                         rule is enforced as ERROR again. -->
                                    <requireUpperBoundDeps>
                                        <level>ERROR</level>
                                    </requireUpperBoundDeps>
                                    <bannedDependencies>
                                        <excludes>
                                            <exclude>commons-logging:commons-logging</exclude>
                                            <exclude>log4j:log4j</exclude>
                                        </excludes>
                                        <message>Legacy logging bridge detected: use spring-jcl + logback only.</message>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <argLine/>
                        <timestampedReports>false</timestampedReports>
                        <mutationThreshold>80</mutationThreshold>
                        <!-- HIGH-3/T-3: line coverage floor catches NO_COVERAGE
                             mutants that mutationThreshold hides (it only
                             scores detected mutants). Single source with
                             pitest-domain profile's stricter 85% domain gate. -->
                        <coverageThreshold>85</coverageThreshold>
                        <excludedMethods>
                            <param>hashCode</param>
                            <param>equals</param>
                        </excludedMethods>
                        <excludedTestClasses>
                            <param>*IntegrationTest</param>
                            <param>*IT</param>
                        </excludedTestClasses>
                        <avoidCallsTo>
                            <avoidCallsTo>org.slf4j</avoidCallsTo>
                            <avoidCallsTo>java.util.logging</avoidCallsTo>
                        </avoidCallsTo>
                        <threads>4</threads>
                        <historyInputFile>${project.build.directory}/pit-history.txt</historyInputFile>
                        <historyOutputFile>${project.build.directory}/pit-history.txt</historyOutputFile>
                        <outputFormats>
                            <param>XML</param>
                            <param>HTML</param>
                        </outputFormats>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacoco.argLine</propertyName>
                            <skip>${jacoco.skip}</skip>
                            <append>true</append>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Long term #8: domain mutation target is 85%. The global threshold stays at 80% (CI stays green).
         Module poms resolve ${pitest.targetClasses.*} properties for targetClasses;
         this profile narrows those properties to domain-only patterns, so the
         profile alone measures the correct scope (the CLI -DtargetClasses override
         is no longer required, kept in nightly as an explicitly stated extra safeguard).
         The nightly workflow's weekly schedule is disabled (2026-10-19), so this
         profile is now exercised by manual dispatch only — the 85% domain number
         is reproducible on demand but is no longer enforced automatically.
         targetTests stay as they are in the module poms. -->
    <profiles>
        <profile>
            <id>pitest-domain</id>
            <properties>
                <pitest.targetClasses.account>com.bank.app.account.domain.*</pitest.targetClasses.account>
                <pitest.targetClasses.accountApi>com.bank.app.account.api.domain.*</pitest.targetClasses.accountApi>
                <pitest.targetClasses.app>com.bank.app.app.domain.*</pitest.targetClasses.app>
                <pitest.targetClasses.audit>com.bank.app.audit.domain.*</pitest.targetClasses.audit>
                <pitest.targetClasses.common>com.bank.app.common.domain.*</pitest.targetClasses.common>
                <pitest.targetClasses.infrastructure>com.bank.app.infrastructure.domain.*</pitest.targetClasses.infrastructure>
                <pitest.targetClasses.persistence>com.bank.app.persistence.domain.*</pitest.targetClasses.persistence>
                <pitest.targetClasses.transfer>com.bank.app.transfer.domain.*</pitest.targetClasses.transfer>
                <pitest.targetClasses.user>com.bank.app.user.domain.*</pitest.targetClasses.user>
                <pitest.targetClasses.webSupport>com.bank.app.websupport.domain.*</pitest.targetClasses.webSupport>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-maven</artifactId>
                            <configuration>
                                <mutationThreshold>85</mutationThreshold>
                                <coverageThreshold>85</coverageThreshold>
                                <!-- Domain-free modules (infrastructure, app, persistence,
                                     account-api) match zero classes under the narrowed
                                     patterns above; they must pass instead of failing. -->
                                <failWhenNoMutations>false</failWhenNoMutations>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

</project>