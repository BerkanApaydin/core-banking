# ─── Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bank_user
DB_PASSWORD=bank_password

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
# Host-side port; the app container uses 6379 internally.
REDIS_PORT=6389
# Managed-Redis AUTH (S-3): set ONLY when the broker enforces AUTH (the app
# reads spring.data.redis.password via Boot relaxed binding). Leave unset —
# never empty — for AUTH-less local Redis.
# SPRING_DATA_REDIS_PASSWORD=change-me

# ─── JWT ────────────────────────────────────────────────
# 256-bit Base64 secret (generate: openssl rand -base64 32)
JWT_SECRET=replace-with-a-256-bit-base64-secret
# Short-lived access tokens (15m) + rotating refresh tokens (7d).
# JWT_EXPIRATION is still honored as the access lifetime for existing setups.
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
# Must be false in production (see ApplicationStartupValidator)
JWT_ALLOW_DEFAULT_SECRET=false

# ─── Spring Profile ─────────────────────────────────────────
# Hosted simulated-funds deployment: prod,simulation. Keep prod security
# settings active; prod alone allows only zero opening balance.
SPRING_PROFILES_ACTIVE=dev

# ─── Reverse proxy ────────────────────────────────────
# Set true ONLY behind a trusted reverse proxy/ingress that overwrites
# X-Forwarded-For. Otherwise IP rate limiting and brute-force lockout
# can be bypassed by spoofing the header.
PROXY_TRUST_HEADERS=false

# ─── CORS ───────────────────────────────────────────────
# Must match application.yml default (bundled UI is served from :8080).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# ─── Token Blacklist ────────────────────────────────────
TOKEN_BLACKLIST_BACKEND=hybrid
TOKEN_BLACKLIST_MIN_TTL_MS=1000
TOKEN_BLACKLIST_MAX_TTL_MS=2592000000

# ─── Password/crypto hardening (audit) ──────────────────
# BCrypt cost factor (log2 rounds). Existing hashes keep verifying after a
# change (cost is embedded in the hash); raise on faster hardware.
PASSWORD_ENCODER_STRENGTH=12
# HSTS max-age in seconds (1 year = preload-list minimum). Lowering weakens
# downgrade protection; negatives are rejected at startup.
HSTS_MAX_AGE_SECONDS=31536000

# ─── MFA (TOTP) + password reset (audit) ──────────────────
# Issuer label shown in authenticator apps during enrollment.
MFA_ISSUER=clean-architecture-bank
# Base64 AES-256 key (32 bytes; generate: openssl rand -base64 32) for
# TOTP-secret encryption at rest. Leave unset ONLY for local dev/test
# (ephemeral in-memory key — secrets die with the JVM). Production refuses
# to boot without it (see ApplicationStartupValidator).
# MFA_ENCRYPTION_KEY=replace-with-a-256-bit-base64-secret
# TOTP step/digits/skew (defaults match authenticator apps).
MFA_PERIOD_SECONDS=30
MFA_DIGITS=6
MFA_SKEW_WINDOWS=1
# Single-use password-reset token lifetime (minutes).
PASSWORD_RESET_TOKEN_MINUTES=15

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_BACKEND=redis
# Auth tier (/api/v1/auth/*): keep tight against credential stuffing.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_TIME_WINDOW_MS=10000
# Resource tier (/api/v1/accounts, /api/v1/transfers, /api/v1/admin):
# authenticated reads; raise for dense dashboards / shared egress IPs.
RATE_LIMIT_RESOURCE_MAX_REQUESTS=120
RATE_LIMIT_RESOURCE_TIME_WINDOW_MS=60000
# Sliding-window cache memory guard (time-based eviction is primary).
RATE_LIMIT_CACHE_MAX_SIZE=10000

# ─── Failed Login ───────────────────────────────────────
FAILED_LOGIN_BACKEND=redis
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_WINDOW_MINUTES=15
# Brute-force counter-cache memory guard (time-based eviction is primary).
FAILED_LOGIN_CACHE_MAX_SIZE=10000

# ─── Transfer ───────────────────────────────────────────
TRANSFER_CANCELLATION_WINDOW_HOURS=24

# ─── Transfer PENDING reaper (R-1) ──────────────────────────
# Crash-window recovery: PENDING rows older than OLDER_THAN are marked FAILED
# through the domain every CRON. Keep OLDER_THAN well above the 30s
# transaction timeout so slow (not dead) placements are never reaped.
TRANSFER_REAPER_ENABLED=true
TRANSFER_REAPER_CRON=0 */5 * * * *
TRANSFER_REAPER_OLDER_THAN=PT15M
TRANSFER_REAPER_BATCH_SIZE=50

# ─── Use-case transactions (programmatic, see UseCaseTransactionAspect) ──
TRANSACTION_TIMEOUT_SECONDS=30

# ─── Idempotency ────────────────────────────────────────
IDEMPOTENCY_CLEANUP_CRON=0 0 * * * *
IDEMPOTENCY_EXPIRATION_HOURS=24
# Retry policy for the generic @Idempotent guard (separate from transfer's
# own use-case retry keys, which have no env override by design).
IDEMPOTENCY_MAX_ATTEMPTS=3
IDEMPOTENCY_INITIAL_DELAY_MS=500

# ─── Orphan integrity (read-only observer alongside V24 foreign keys) ──
ORPHAN_CHECK_ENABLED=true
ORPHAN_CHECK_CRON=0 0 3 * * *
ORPHAN_ALARM_THRESHOLD=0

# ─── Audit ────────────────────────────────────────────
# Legal trail retention (default 365d — far longer than the 30d outbox window).
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_CRON=0 0 4 * * 0
AUDIT_MAX_QUERY_LIMIT=500

# ─── Backlog metrics (read-only PostgreSQL scan per replica) ──────────
BACKLOG_METRICS_ENABLED=true
BACKLOG_METRICS_SCAN_DELAY_MS=60000

# ─── Outbox ─────────────────────────────────────────────
OUTBOX_POLL_ENABLED=true
OUTBOX_POLL_DELAY_MS=2000
OUTBOX_MAX_RETRIES=5
OUTBOX_PARTITION_COUNT=2
OUTBOX_BATCH_SIZE=50
# Worker sizing: workers-per-partition x partition-count must stay under the
# Hikari pool (see application.yml PERF-8 note). The worker timeout must stay
# aligned with TRANSACTION_TIMEOUT_SECONDS.
OUTBOX_WORKERS_PER_PARTITION=4
OUTBOX_MAX_WORKERS=12
OUTBOX_WORKER_TIMEOUT_SECONDS=30

# ─── Caffeine account-info cache ──────────────────────────
# Snapshot-cache backend: caffeine = single-JVM (dev/test), redis = shared
# across replicas (production, required with HPA multi-replica).
# Canonical keys are app.cache.account-info.* (legacy
# app.cache.caffeine.account-info.* still honored as fallback); both map to
# the same env vars below, so they agree unless explicitly overridden.
CACHE_ACCOUNT_INFO_BACKEND=redis
CACHE_ACCOUNT_INFO_MAX_SIZE=1000
CACHE_ACCOUNT_INFO_EXPIRE_SEC=60
CACHE_ACCOUNT_INFO_EVICTION_BATCH_SIZE=500
# Operational evict-all (full-region SCAN) is off-peak only; mutations always
# use granular evictById. See docs/account-snapshot-cache.md.
